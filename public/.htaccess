DirectoryIndex index.html
Options -Indexes
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Agar request actual file ke liye hai (e.g. JS, CSS, images), toh waise hi serve karo
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Signatureheritage, Paradise, Ultimateheight jaha folder aur html dono hain:
  # Hostinger ko folder par 404/403 dene se roko aur direct .html file serve karo
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)/?$ /$1.html [L]

  # 3. Sub-pages ke liye (e.g. signatureheritage/thankyou -> signatureheritage/thankyou.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

ErrorDocument 404 /404.html