DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# 1. अगर URL के अंत में / है तो उसे हटाओ (redirect /ultimateheight/ to /ultimateheight)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

# 2. Clean URL को .html फ़ाइल से जोड़ो (/ultimateheight -> /ultimateheight.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# Custom 404 page
ErrorDocument 404 /404.html